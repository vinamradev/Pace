# ==============================================================================
# PACE FINANCE - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb://localhost:27017/pace

# JWT Token Secret (Change to a long random secret in production)
JWT_SECRET=pace_jwt_secure_super_secret_key_2026_production
JWT_EXPIRES_IN=30d

# Google OAuth 2.0 Client ID (from Google Cloud Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# Email Notification System (Nodemailer SMTP Configuration)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_google_app_password
# EMAIL_FROM="PACE Finance" <no-reply@pace.finance>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PACE Finance" <no-reply@pace.finance>

# Allowed Frontend URL for CORS in Production
FRONTEND_URL=http://localhost:5173
